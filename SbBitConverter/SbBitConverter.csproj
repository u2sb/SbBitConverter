<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>netstandard2.0;netstandard2.1;net6.0;net8.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<LangVersion>preview</LangVersion>
		<AssemblyName>SbBitConverter</AssemblyName>
		<PackageId>SbBitConverter</PackageId>
		<PackageTags>BitConverter,Modbus,Iot</PackageTags>
		<Description>Sb BitConverter</Description>
		<PackageProjectUrl>https://github.com/u2sb/SbBitConverter.git</PackageProjectUrl>
		<GeneratePackageOnBuild>false</GeneratePackageOnBuild>
		<Title>SbBitConverter</Title>
		<Authors>MonoLogueChi</Authors>
		<Company>U2SB</Company>
		<RepositoryUrl>https://github.com/u2sb/SbBitConverter.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageIcon>avatar.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<Copyright>U2SB</Copyright>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
		<AllowUnsafeBlocks>True</AllowUnsafeBlocks>
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\SbBitConverter.SourceGenerator\SbBitConverter.SourceGenerator.csproj" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\SbBitConverter.SourceGenerator-4.3\SbBitConverter.SourceGenerator.4.3.csproj" ReferenceOutputAssembly="false" />
		<!-- PrivateAssets=all：阻断 NuGet 把该引用写成包依赖（DLL 由下方 Target 手工打入 lib/{tfm}，
		     消费端按 NuGet 规则自动引用 lib 下全部程序集） -->
		<ProjectReference Include="..\Sb.Extensions\Sb.Extensions.csproj" PrivateAssets="all" />
	</ItemGroup>

	<!-- 打包时把 Sb.Extensions.dll + pdb 带入对应 lib/{tfm}（NuGet 会自动引用 lib 下全部程序集）。
	     注意：多目标打包的 GenerateNuspec 在外层构建运行（此时 $(TargetFramework) 为空），
	     因此必须按 TFM 静态声明，不能用动态 Target。 -->
	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0' Or '$(TargetFramework)' == ''">
		<None Include="..\Sb.Extensions\bin\$(Configuration)\net10.0\Sb.Extensions.dll" PackagePath="lib/net10.0" Pack="true" Visible="false" />
		<None Include="..\Sb.Extensions\bin\$(Configuration)\net10.0\Sb.Extensions.pdb" PackagePath="lib/net10.0" Pack="true" Visible="false" />
		<None Include="..\Sb.Extensions\bin\$(Configuration)\net10.0\Sb.Extensions.xml" PackagePath="lib/net10.0" Pack="true" Visible="false" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == ''">
		<None Include="..\Sb.Extensions\bin\$(Configuration)\net8.0\Sb.Extensions.dll" PackagePath="lib/net8.0" Pack="true" Visible="false" />
		<None Include="..\Sb.Extensions\bin\$(Configuration)\net8.0\Sb.Extensions.pdb" PackagePath="lib/net8.0" Pack="true" Visible="false" />
		<None Include="..\Sb.Extensions\bin\$(Configuration)\net8.0\Sb.Extensions.xml" PackagePath="lib/net8.0" Pack="true" Visible="false" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'net6.0' Or '$(TargetFramework)' == ''">
		<None Include="..\Sb.Extensions\bin\$(Configuration)\net6.0\Sb.Extensions.dll" PackagePath="lib/net6.0" Pack="true" Visible="false" />
		<None Include="..\Sb.Extensions\bin\$(Configuration)\net6.0\Sb.Extensions.pdb" PackagePath="lib/net6.0" Pack="true" Visible="false" />
		<None Include="..\Sb.Extensions\bin\$(Configuration)\net6.0\Sb.Extensions.xml" PackagePath="lib/net6.0" Pack="true" Visible="false" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1' Or '$(TargetFramework)' == ''">
		<None Include="..\Sb.Extensions\bin\$(Configuration)\netstandard2.1\Sb.Extensions.dll" PackagePath="lib/netstandard2.1" Pack="true" Visible="false" />
		<None Include="..\Sb.Extensions\bin\$(Configuration)\netstandard2.1\Sb.Extensions.pdb" PackagePath="lib/netstandard2.1" Pack="true" Visible="false" />
		<None Include="..\Sb.Extensions\bin\$(Configuration)\netstandard2.1\Sb.Extensions.xml" PackagePath="lib/netstandard2.1" Pack="true" Visible="false" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0' Or '$(TargetFramework)' == ''">
		<None Include="..\Sb.Extensions\bin\$(Configuration)\netstandard2.0\Sb.Extensions.dll" PackagePath="lib/netstandard2.0" Pack="true" Visible="false" />
		<None Include="..\Sb.Extensions\bin\$(Configuration)\netstandard2.0\Sb.Extensions.pdb" PackagePath="lib/netstandard2.0" Pack="true" Visible="false" />
		<None Include="..\Sb.Extensions\bin\$(Configuration)\netstandard2.0\Sb.Extensions.xml" PackagePath="lib/netstandard2.0" Pack="true" Visible="false" />
	</ItemGroup>

	<!-- Sb.Extensions 独立成 DLL 后，其运行时依赖需在本包 nuspec 显式声明（版本由 Directory.Packages.props 统一） -->
	<ItemGroup>
		<PackageReference Include="CommunityToolkit.HighPerformance" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
	</ItemGroup>
	<ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces" />
		<PackageReference Include="Microsoft.Bcl.Memory" />
		<PackageReference Include="System.Buffers" />
		<PackageReference Include="System.Memory" />
		<PackageReference Include="System.Runtime.CompilerServices.Unsafe" />
		<PackageReference Include="System.Threading.Tasks.Extensions" />
	</ItemGroup>

	<ItemGroup>
		<None Include="SbBitConverter.targets" PackagePath="build" Pack="true" />
		<None Include="..\SbBitConverter.SourceGenerator\bin\$(Configuration)\netstandard2.0\SbBitConverter.SourceGenerator.dll" PackagePath="analyzers\dotnet\roslyn4.8\cs" Pack="true" Visible="false" />
		<None Include="..\SbBitConverter.SourceGenerator-4.3\bin\$(Configuration)\netstandard2.0\SbBitConverter.SourceGenerator.dll" PackagePath="analyzers\dotnet\roslyn4.3\cs" Pack="true" Visible="false" />
	</ItemGroup>

	<!-- （原 Sb.Extensions 共享项目已改为独立类库，见 ..\Sb.Extensions\Sb.Extensions.csproj） -->

	<ItemGroup>
		<None Include="..\icons\avatar.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\README.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>